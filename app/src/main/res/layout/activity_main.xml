<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#121212">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AuthVaultix SDK"
            android:textColor="#00D2FF"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Connecting to servers..."
            android:textColor="#FFEB3B"
            android:textSize="14sp"
            android:layout_marginBottom="16dp" />

        <!-- 1. AUTH SCREEN VIEW -->
        <LinearLayout
            android:id="@+id/layoutAuth"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1E1E1E"
            android:padding="20dp"
            android:layout_marginBottom="16dp"
            android:elevation="4dp">

            <EditText
                android:id="@+id/etUsername"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="Username"
                android:textColorHint="#777777"
                android:textColor="#FFFFFF"
                android:padding="12dp"
                android:layout_marginBottom="12dp"
                android:inputType="text" />

            <EditText
                android:id="@+id/etPassword"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="Password"
                android:textColorHint="#777777"
                android:textColor="#FFFFFF"
                android:padding="12dp"
                android:layout_marginBottom="12dp"
                android:inputType="textPassword" />

            <EditText
                android:id="@+id/etLicense"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="License Key"
                android:textColorHint="#777777"
                android:textColor="#FFFFFF"
                android:padding="12dp"
                android:layout_marginBottom="12dp"
                android:inputType="text" />

            <EditText
                android:id="@+id/etEmail"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="Email (Optional)"
                android:textColorHint="#777777"
                android:textColor="#FFFFFF"
                android:padding="12dp"
                android:layout_marginBottom="20dp"
                android:inputType="textEmailAddress" />

            <Button
                android:id="@+id/btnLogin"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="Login"
                android:textColor="#FFFFFF"
                android:backgroundTint="#2C2C2C"
                android:layout_marginBottom="10dp" />

            <Button
                android:id="@+id/btnRegister"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="Register"
                android:textColor="#FFFFFF"
                android:backgroundTint="#2C2C2C"
                android:layout_marginBottom="10dp" />

            <Button
                android:id="@+id/btnLicenseLogin"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="License Login"
                android:textColor="#FFFFFF"
                android:backgroundTint="#2C2C2C"
                android:layout_marginBottom="10dp" />

            <Button
                android:id="@+id/btnUpgrade"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="Upgrade Account"
                android:textColor="#FFFFFF"
                android:backgroundTint="#2C2C2C"
                android:layout_marginBottom="10dp" />

            <Button
                android:id="@+id/btnForgot"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="Forgot Password"
                android:textColor="#FFFFFF"
                android:backgroundTint="#2C2C2C" />

        </LinearLayout>

        <!-- 2. DASHBOARD VIEW (Initially GONE) -->
        <LinearLayout
            android:id="@+id/layoutDashboard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:background="#1E1E1E"
            android:padding="20dp"
            android:elevation="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="User Information"
                android:textColor="#00D2FF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="10dp" />

            <!-- User Data Display -->
            <TextView
                android:id="@+id/tvUserData"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:text="No user data loaded."
                android:layout_marginBottom="20dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#444444"
                android:layout_marginBottom="20dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Actions"
                android:textColor="#00D2FF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="10dp" />

            <!-- Session & Blacklist & Ban -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <Button
                    android:id="@+id/btnCheckSession"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:text="Check Session"
                    android:textSize="11sp"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#2C2C2C"
                    android:layout_marginRight="4dp" />

                <Button
                    android:id="@+id/btnCheckBlacklist"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:text="Check Blacklist"
                    android:textSize="11sp"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#2C2C2C"
                    android:layout_marginLeft="4dp" />

            </LinearLayout>

            <Button
                android:id="@+id/btnBan"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="Trigger Ban (Test)"
                android:textColor="#FFFFFF"
                android:backgroundTint="#2C2C2C"
                android:layout_marginBottom="16dp" />

            <!-- Logs input -->
            <EditText
                android:id="@+id/etLogData"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="Enter Log Message"
                android:textColorHint="#777777"
                android:textColor="#FFFFFF"
                android:padding="12dp"
                android:layout_marginBottom="8dp" />

            <Button
                android:id="@+id/btnSendLog"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="Send Log"
                android:textColor="#FFFFFF"
                android:backgroundTint="#2C2C2C"
                android:layout_marginBottom="16dp" />

            <!-- File download -->
            <EditText
                android:id="@+id/etFileId"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="File ID (e.g. EC5FF376)"
                android:textColorHint="#777777"
                android:textColor="#FFFFFF"
                android:padding="12dp"
                android:layout_marginBottom="8dp" />

            <Button
                android:id="@+id/btnDownload"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="Download File"
                android:textColor="#FFFFFF"
                android:backgroundTint="#2C2C2C"
                android:layout_marginBottom="16dp" />

            <!-- Global Variable -->
            <EditText
                android:id="@+id/etGlobalVarKey"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="Global Variable Key"
                android:textColorHint="#777777"
                android:textColor="#FFFFFF"
                android:padding="12dp"
                android:layout_marginBottom="8dp" />

            <Button
                android:id="@+id/btnGetGlobalVar"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="Fetch Global Variable"
                android:textColor="#FFFFFF"
                android:backgroundTint="#2C2C2C"
                android:layout_marginBottom="16dp" />

            <!-- User Variable -->
            <EditText
                android:id="@+id/etUserVarKey"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="User Variable Key"
                android:textColorHint="#777777"
                android:textColor="#FFFFFF"
                android:padding="12dp"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/etUserVarValue"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="User Variable Value"
                android:textColorHint="#777777"
                android:textColor="#FFFFFF"
                android:padding="12dp"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <Button
                    android:id="@+id/btnGetUserVar"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:text="Get User Var"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#2C2C2C"
                    android:layout_marginRight="4dp" />

                <Button
                    android:id="@+id/btnSetUserVar"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:text="Set User Var"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#2C2C2C"
                    android:layout_marginLeft="4dp" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#444444"
                android:layout_marginBottom="20dp" />

            <!-- Online Users -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Online Users"
                android:textColor="#00D2FF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="10dp" />

            <TextView
                android:id="@+id/tvOnlineUsers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:text="No online users loaded."
                android:layout_marginBottom="20dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#444444"
                android:layout_marginBottom="20dp" />

            <!-- Chat Room -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chat Room"
                android:textColor="#00D2FF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="10dp" />

            <EditText
                android:id="@+id/etChatMsg"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="Type message..."
                android:textColorHint="#777777"
                android:textColor="#FFFFFF"
                android:padding="12dp"
                android:layout_marginBottom="8dp" />

            <Button
                android:id="@+id/btnSendChat"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="Send Message"
                android:textColor="#FFFFFF"
                android:backgroundTint="#2C2C2C"
                android:layout_marginBottom="16dp" />

            <TextView
                android:id="@+id/tvChatMessages"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:scrollbars="vertical"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:text="Loading chat..."
                android:background="#121212"
                android:padding="8dp" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
